# ============================================================
# DATOS (archivos pesados ignorados para GitHub)
# Se mantienen las carpetas vacías mediante .gitkeep
# ============================================================

# data/raw — archivos planos, comprimidos y subcarpetas con CSVs
data/raw/*
!data/raw/.gitkeep
data/raw/**/*.csv
data/raw/**/*.pcap

# data/processed — archivos Parquet (no estaban cubiertos antes)
data/processed/*
!data/processed/.gitkeep
*.parquet

# data/final — arrays NumPy (no estaban cubiertos antes)
data/final/*
!data/final/.gitkeep
*.npy

# models/classifiers — modelos de ML (Random Forest, LightGBM, XGBoost) — archivos .pkl grandes
models/classifiers/*.pkl

# models/deep_learning — modelos de Deep Learning Keras
models/deep_learning/*.keras

# ============================================================
# MODELOS Y ARTEFACTOS
# ============================================================

# Modelos de ML (Random Forest, LightGBM, XGBoost) — archivos .pkl grandes
models/classifiers/*.pkl
!models/classifiers/.gitkeep
src/Results/*.pkl
!src/Results/.gitkeep
src/ML_Simple/Resultados/*.pkl
!src/ML_Simple/Resultados/.gitkeep

# Modelos de Deep Learning Keras
*.keras

# Escaladores y Encoders pequeños en models/scalers_encoders/ SÍ se rastrean (no se ignoran)

# ============================================================
# ARCHIVOS COMPRIMIDOS Y FORMATOS PESADOS (global)
# ============================================================
*.zip
*.rar
*.7z
*.csv
*.pcap

# ============================================================
# SISTEMA OPERATIVO
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
